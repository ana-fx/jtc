# Bot token from the Discord Developer Portal (Bot > Reset Token)
DISCORD_TOKEN=

# Application ID / Client ID (General Information > Application ID)
CLIENT_ID=

# ID of the server (Guild) where the bot is used.
# Right-click the server name > Copy Server ID (enable Developer Mode first
# under Settings > Advanced)
GUILD_ID=

# ID of the "Ruang Game" voice channel. Users must be connected here while
# picking a game from the picker in that category's #pengaturan channel.
# Right-click the voice channel > Copy Channel ID
GAME_LOBBY_CHANNEL_ID=

# Comma-separated lists of games offered in the picker, split into two
# dropdowns (PC / Mobile).
GAMES_PC=Valorant,Minecraft Java,Roblox,Dota 2,PUBG,Counter-Strike 2
GAMES_MOBILE=Mobile Legends,PUBG Mobile,Free Fire,Call of Duty Mobile,Genshin Impact,Wild Rift,Arena of Valor,Honor of Kings,Minecraft Bedrock

# Optional: restrict /report to only work in this text channel (so all
# reports funnel into one place staff can monitor together). Leave unset to
# allow /report anywhere.
REPORT_CHANNEL_ID=

# Optional: restrict /resep to only work in this text channel. Leave unset
# to allow /resep anywhere.
RESEP_CHANNEL_ID=

# Optional: comma-separated text channel ids where general commands
# (/work, /daily, /balance, /level, /couple, /help) are allowed — e.g. the
# "allbot" channels in ARCADE AREA. A game room's own auto-created chat is
# never in this list, so commands naturally don't work there. Leave unset to
# allow these commands anywhere.
BOT_CHANNEL_IDS=
