# Bot token from the Discord Developer Portal (Bot > Reset Token)
DISCORD_TOKEN=

# Application ID / Client ID (General Information > Application ID)
CLIENT_ID=

# ID of the server (Guild) where the bot is used.
# Right-click the server name > Copy Server ID (enable Developer Mode first
# under Settings > Advanced)
GUILD_ID=

# ID of the "lobby" voice channel. Users who join this channel will
# automatically get a new voice room created for them.
# Right-click the voice channel > Copy Channel ID
JOIN_TO_CREATE_CHANNEL_ID=

# (Optional) ID of the category where new rooms are created. Leave empty to
# use the same category as the lobby channel. Only applies to the single
# lobby above; LOBBIES entries always use their own lobby's category.
CATEGORY_ID=

# (Optional) Additional lobbies with a user-limit range per room type.
# Format: <voiceChannelId>:<minLimit>:<maxLimit> separated by commas.
# maxLimit 0 means no upper bound. Rooms start at minLimit and the owner can
# only change the limit within the range. Rooms are created in the same
# category as their lobby. Example (Bedroom 1-3, Library 4-6, Family Room 7+):
# LOBBIES=111111111111111111:1:3,222222222222222222:4:6,333333333333333333:7:0
LOBBIES=
